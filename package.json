{
  "name": "app-settings-kit",
  "version": "1.0.0",
  "description": "The standard Settings screen for React Native / Expo apps, built on app-account-kit: About, Account, Preferences, Data Export and a plan page in one config. Adds the kits list, the version and build line, the build-time stamp and a Data Export page with a lock per format. No colors and no payment or export code of its own.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./logic": "./src/logic/index.ts",
    "./build-stamp": "./build-stamp.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "build-stamp.js",
    "build-stamp.d.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "sideEffects": false,
  "author": "Yuvaraj Salla",
  "peerDependencies": {
    "app-account-kit": ">=7.7.0",
    "react": ">=18",
    "react-native": ">=0.74"
  },
  "devDependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@types/node": "^22.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "app-account-kit": "git+https://github.com/yuvarajsalla20/app-account-kit.git#8613ded8457fa8221e1973b70a21869bbbb7893f",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^2.1.9"
  }
}
