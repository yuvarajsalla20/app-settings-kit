{
  "name": "app-settings-kit",
  "version": "8.0.0",
  "description": "The standard Settings screen for React Native / Expo apps, built on app-account-kit: About, Account, Preferences and a plan page in one config, with Data Export inside Account (or Preferences). Adds the kits list, the version and build line, the build-time stamp and a Data Export page with a lock per format. No colors and no payment or export code of its own.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./logic": "./src/logic/index.ts",
    "./parts": "./src/parts/index.ts",
    "./build-stamp": "./build-stamp.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "build-stamp.js",
    "build-stamp.d.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "sideEffects": false,
  "author": "Yuvaraj Salla",
  "peerDependencies": {
    "@expo/vector-icons": ">=14",
    "app-account-kit": ">=7.30.0",
    "expo-application": ">=6",
    "expo-constants": ">=17",
    "expo-image-manipulator": ">=13",
    "expo-image-picker": ">=16",
    "react": ">=18",
    "react-native": ">=0.74"
  },
  "devDependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@types/node": "^22.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "app-account-kit": "git+https://github.com/yuvarajsalla20/app-account-kit.git#da25d6e22af0e44537de38afbc3373eb1a394895",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.15",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^2.1.9"
  }
}
